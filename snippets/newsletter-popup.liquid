<div class="nl-popup" id="nl-popup" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Newsletter Angebot">
  <div class="nl-popup__overlay" id="nl-popup-overlay"></div>
  <div class="nl-popup__box">
    <button class="nl-popup__close" id="nl-popup-close" aria-label="Schließen">&#10005;</button>
    <div class="nl-popup__inner">
      <p class="nl-popup__label">EXKLUSIV FÜR DICH</p>
      <h2 class="nl-popup__heading">15% Rabatt<br>auf deine erste Bestellung</h2>
      <p class="nl-popup__sub">Trage dich in unseren Newsletter ein und erhalte sofort deinen persönlichen Rabattcode.</p>
      <form class="nl-popup__form" id="nl-popup-form">
        <input
          type="email"
          class="nl-popup__input"
          placeholder="Deine E-Mail-Adresse"
          required
          autocomplete="email"
        >
        <button type="submit" class="nl-popup__btn">CODE ANFORDERN</button>
      </form>
      <div class="nl-popup__success" id="nl-popup-success" style="display:none">
        <p class="nl-popup__success-text">Dein Rabattcode:</p>
        <div class="nl-popup__code">VENATICI15</div>
        <p class="nl-popup__success-sub">Einfach beim Checkout eingeben. Viel Freude mit deinem Duft.</p>
      </div>
      <p class="nl-popup__privacy">Kein Spam. Jederzeit abmeldbar.</p>
    </div>
  </div>
</div>
